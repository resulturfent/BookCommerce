    <!-- Sol alt tarafta Kategoriler -->
    <div id="sidebar">
        <h3>Kategoriler</h3>
        <ul id="category-list">
            <!-- Kategoriler buraya dinamik olarak gelecek -->
        </ul>
    </div>

    <script>
        // Alt kategorileri gösterecek fonksiyon
        function showCategories(category) {
            const categoryList = document.getElementById('category-list');
            categoryList.innerHTML = ''; // Önce temizle

            let subCategories = [];
            if (category === 'kitap') {
                subCategories = ['Roman', 'Bilim Kurgu', 'Aşk'];
            } else if (category === 'elektronik') {
                subCategories = ['Telefon', 'Bilgisayar', 'Tablet', 'Televizyon'];
            }

            subCategories.forEach(function(subCategory) {
                const li = document.createElement('li');
                li.innerHTML = `<a href="#">${subCategory}</a>`;
                categoryList.appendChild(li);
            });

            // Kategorileri göster
            categoryList.style.display = 'block';
        }

        // Alt kategorileri gizle
        function hideCategories() {
            const categoryList = document.getElementById('category-list');
            categoryList.style.display = 'none';
        }

        // Kategori sayfasına git
        function goToCategoryPage() {
            window.location.href = 'kitaplar.html'; // Kitaplar sayfasına yönlendirir
        }
    </script>

<script>
    document.querySelector('.login-btn').addEventListener('click', function() {
        var dropdownContent = document.querySelector('.dropdown-content');
        if (dropdownContent.style.display === 'block') {
            dropdownContent.style.display = 'none';
        } else {
            dropdownContent.style.display = 'block';
        }
    });
    </script>
    

