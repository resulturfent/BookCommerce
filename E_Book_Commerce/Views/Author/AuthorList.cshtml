@using DAL.Data
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model List<Book_Commerce.Models.AuthorViewModel>
@inject AppDbContext _context

<h1 style="font-size: 1.5rem; text-align: center; margin-bottom: 20px;">Authors</h1>
<div>
    <a href="~/Author/AddAuthorAdmin" class="btn btn-success">Yazar Ekle</a>

</div>
<table class="table" style="font-size: 0.85rem; width: 100%; table-layout: fixed; border-collapse: collapse;">
    <thead style="background-color: #f8f9fa;">
        <tr>
            <th scope="col" style="width: 10%; padding: 5px; text-align: center;">Id</th>
            <th scope="col" style="width: 30%; padding: 5px;">Author Name</th>
            <th scope="col" style="width: 30%; padding: 5px;">Author Surname</th>
            <th scope="col" style="width: 15%; padding: 5px; text-align: center;">Delete</th>
            <th scope="col" style="width: 15%; padding: 5px; text-align: center;">Update</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)

        {
            <tr>
                <td style="padding: 5px; text-align: center;">@author.Id</td>
                <td style="padding: 5px;">@author.AuthorName</td>
                <td style="padding: 5px;">@author.AuthorSurname</td>
                <td style="padding: 5px; text-align: center;">
                    <form asp-controller="Author" asp-action="Delete" method="post" data-action="delete">
                        <input type="hidden" name="authorId" value="@author.Id" />
                        <button type="submit" class="btn btn-danger btn-sm" style="font-size: 0.75rem;"><i class="fa-solid fa-trash"></i> Delete</button>
                    </form>
                </td>
                <td style="padding: 5px; text-align: center;">
                    <form asp-controller="Author" asp-action="UpdateAuthor" method="get" data-action="update">
                        <input type="hidden" name="authorId" value="@author.Id" />
                        <button type="submit" class="btn btn-warning btn-sm" style="font-size: 0.75rem;"><i class="fa-solid fa-pen-to-square"></i> Update</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>


<script>
    document.querySelectorAll('form[data-action="delete"]').forEach(form => {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (confirm('Are you sure you want to delete this author?')) {
                this.submit();
            }
        });
    });

    document.querySelectorAll('form[data-action="update"]').forEach(form => {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (confirm('Are you sure you want to update this author?')) {
                this.submit();
            }
        });
    });
</script>
