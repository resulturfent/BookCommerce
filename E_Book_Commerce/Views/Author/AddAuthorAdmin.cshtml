@using Book_Commerce.Models
@model AuthorViewModel

<div class="container mt-5">
    <div class="col-6">
<h1>Add Author</h1>

        <form id="registerForm" asp-controller="Author" asp-action="AddAuthorAdmin" method="post">
        <div class="form-group">
         <label asp-for="AuthorName">Author Name</label>
            <input asp-for="AuthorName" class="form-control" />
                 <span asp-validation-for="AuthorName" class="text-danger"></span>
         </div>
    <div class="form-group">
        <label asp-for="AuthorSurname">Author Surname</label>
        <input asp-for="AuthorSurname" class="form-control" />
        <span asp-validation-for="AuthorSurname" class="text-danger"></span>
    </div>

             <button type="submit" class="btn btn-primary">Add New Author </button>
        </form>
    </div>
</div>


