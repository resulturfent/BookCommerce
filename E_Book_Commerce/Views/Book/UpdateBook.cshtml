@using Book_Commerce.Models
@model BookViewModel

<div class="container mt-5">
    <h1>Update Book</h1>

    <form id="updateForm" asp-controller="Book" asp-action="UpdateBook" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label for="Title">Title:</label>
            <input id="nameId" asp-for="Title" type="text" class="form-control" required />
            <span id="nameError" class="text-danger"></span>
        </div>

        @{
            var sortedAuthors = ((IEnumerable<dynamic>)ViewBag.Authors)
                .OrderBy(item => item.GetType().GetProperty("AuthorName").GetValue(item))
                .ToList();
        }
        <div class="form-group">
            <label for="AuthorName">Select Author:</label>
            <select asp-for="Id" class="form-control">
                @foreach (var item in sortedAuthors)
                {
                    <option value="@item.GetType().GetProperty("Id").GetValue(item)" name="authorIds">
                        <p>@item.GetType().GetProperty("AuthorName").GetValue(item)</p>
                        <p>@item.GetType().GetProperty("AuthorSurname").GetValue(item)</p>
                    </option>


                }
            </select>
        </div>

        @{
            var sortedCategories = ((IEnumerable<dynamic>)ViewBag.Categories)
                .OrderBy(item => item.GetType().GetProperty("CategoryName").GetValue(item))
                .ToList();
        }
        <div class="form-group">
            <label for="CategoryName">Select Category:</label>
            <select asp-for="Id" class="form-control">
                @foreach (var item in sortedCategories)
                {
                    <option value="@item.GetType().GetProperty("Id").GetValue(item)">
                        @item.GetType().GetProperty("CategoryName").GetValue(item)
                    </option>
                }
            </select>
        </div>

        <div class="form-group">
            <label for="Description">Description:</label>
            <textarea asp-for="Description" class="form-control" required></textarea>
        </div>

        <div class="form-group">
            <label for="PhotoUrl">Change Photo:</label>
            <input asp-for="PhotoUrl" type="file" class="form-control" accept="image/*" />
        </div>

        <div class="form-group">
            <label for="PublishingHouse">Publishing House:</label>
            <input asp-for="PublishingHouse" type="text" class="form-control" required />
        </div>

        <div class="form-group">
            <label for="ISBN">ISBN No:</label>
            <input asp-for="ISBN" type="text" class="form-control" required />
        </div>

        <div class="form-group">
            <label for="PublishedDate">Published Date:</label>
            <input asp-for="PublishedDate" type="date" class="form-control" required />
        </div>

        <div class="form-group">
            <label for="UnitPrice">Unit Price:</label>
            <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" required />
        </div>

        <div class="form-group">
            <label for="UnitInStocks">Unit In Stocks:</label>
            <input asp-for="UnitInStocks" type="number" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">Update Book</button>
    </form>
</div>
