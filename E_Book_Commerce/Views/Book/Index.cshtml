@using BLL
@using Book_Commerce.Models
@using DAL.Data
@model List<BookViewModel>


<h1>Books</h1>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Title</th>
          @*   <th scope="col">Author</th>
            <th scope="col">Category</th> *@
            <th scope="col">Description</th>
            <th scope="col">Photo</th>
            <th scope="col">Publishing House</th>
            <th scope="col">Published Date</th>
            <th scope="col">Unit Price</th>
            <th scope="col">Unit In Stocks</th>
            <th scope="col">Confirm</th>
            <th scope="col">Like</th>
            <th scope="col">Delete</th>
            <th scope="col">Update</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {

            <tr>
                <!-- Her kitap için bir tablo satırı -->
                <td>@book.Title</td> <!-- Kitap başlığı -->
                <td>@book.AuthorName</td> <!-- Yazar adı, ViewModel'den alabilirsiniz -->
                <!--Yukarıdaki komutta yazar adı seçilince kitap kaydı yapılırken yazar adı görünmuyor. daha sonra tekrar incelemeyi unutma!!! -->
                <td>@book.CategoryName</td>
                <td>@book.Description</td> <!-- Kitap açıklaması -->
                <td><img height="100px" width="100px" src="~/Images/@book.Photo" alt="Book Photo" /></td> <!-- Kitap fotoğrafı -->
                <td>@book.PublishingHouse</td> <!-- Yayınevi -->
                <td>@book.PublishedDate.ToShortDateString()</td> <!-- Yayınlanma tarihi, tarih formatı kısa olarak ayarlandı -->
                <td>@book.UnitPrice</td> <!-- Birim fiyat -->
                <td>@book.UnitInStocks</td> <!-- Stok adedi -->
                <!-- Buraya onay, beğeni, silme ve güncelleme işlemleri için butonlar ekleyebilirsiniz -->
                <td>
                    <button class="btn btn-success">Confirm</button>
                </td>
                <td>
                    <button class="btn btn-primary">Like</button>
                </td>
                <td>
                    <form asp-controller="Book" asp-action="DeleteBook" method="post" data-action="delete">
                        <input type="hidden" name="bookId" value="@book.Id" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
                <td>
                    <form asp-controller="Book" asp-action="UpdateBook" method="get" data-action="update">
                        <input type="hidden" name="bookId" value="@book.Id" />
                        <button type="submit" class="btn btn-warning">Update</button>
                    </form>
                </td>
                <td>
                    <button class="btn btn-warning">Sepete Ekle</button>
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
document.querySelectorAll('form[data-action="delete"]').forEach(form => {
    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (confirm('Are you sure you want to delete this book?')) {
            this.submit();
        }
    });
});

    document.querySelectorAll('form[data-action="update"]').forEach(form => {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (confirm('Are you sure you want to update this book?')) {
                this.submit();
            }
        });
    });
</script>


